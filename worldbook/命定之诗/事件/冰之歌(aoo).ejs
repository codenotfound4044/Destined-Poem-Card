<%_ { // start block: 避免变量名冲突 _%>

<%_
let time = getMessageVar('stat_data.事件.冰之歌.触发时间') || null;
let floor = getMessageVar('stat_data.事件.冰之歌.触发楼层') || null;
let time2 = getMessageVar('stat_data.事件.冰之歌.二阶段触发时间') || null;
let floor2 = getMessageVar('stat_data.事件.冰之歌.二阶段触发楼层') || null;
let time3 = getMessageVar('stat_data.事件.冰之歌.三阶段触发时间') || null;
let floor3 = getMessageVar('stat_data.事件.冰之歌.三阶段触发楼层') || null;
const currentFloor = lastMessageId;
const level = getMessageVar('stat_data.主角.等级', { defaults: 0 });
const lag = 16;
if (getMessageVar('stat_data.事件.冰之歌.异神已击败') == null) {
  setMessageVar('stat_data.事件.冰之歌.异神已击败', false);
}
const hasDefeated = getMessageVar('stat_data.事件.冰之歌.异神已击败', { defaults: false }) === true;

if (level >= 10){
  if (time==null){
    time = getMessageVar('stat_data.世界.时间') || null;
    floor = currentFloor;
    setMessageVar('stat_data.事件.冰之歌.触发时间', time);
    setMessageVar('stat_data.事件.冰之歌.触发楼层', floor);
  }
}

if (level >= 15){  // 要是想后期来打的话修改这里的等级
  if (time2==null){
    time2 = getMessageVar('stat_data.世界.时间') || null;
    floor2 = currentFloor;
    setMessageVar('stat_data.事件.冰之歌.二阶段触发时间', time2);
    setMessageVar('stat_data.事件.冰之歌.二阶段触发楼层', floor2);
  }
}

if (hasDefeated && time3 == null){
  time3 = getMessageVar('stat_data.世界.时间') || null;
  floor3 = currentFloor;
  setMessageVar('stat_data.事件.冰之歌.三阶段触发时间', time3);
  setMessageVar('stat_data.事件.冰之歌.三阶段触发楼层', floor3);
}

const phase1Recent = floor != null && currentFloor >= floor && currentFloor - floor <= lag;
const phase2Recent = floor2 != null && currentFloor >= floor2 && currentFloor - floor2 <= lag;
const phase3Recent = floor3 != null && currentFloor >= floor3 && currentFloor - floor3 <= lag;
_%>

<%_
if (time!=null){
_%>
<世界大事记_冰之歌>
  - [<%= time _%>] 北境长垣防线崩溃
<%_
  if(time2!=null){
_%>
  - [<%= time2 _%>] 异神在北境降临，开始南下
<%_
  }
  if(time3!=null){
_%>
  - [<%= time3 _%>] 异神被击败，冰之歌落幕
<%_
  }
_%>
...
</世界大事记_冰之歌>
<%_
}
_%>

<%_ if (phase3Recent) { _%>
<event>
触发: 冰之歌事件进入三阶段，异神已被击败
要求: 将异神败亡视为大陆共同经历的重大胜利，并在符合当前地点与时间条件的前提下，安排一场有具体人物、仪式或民间活动参与的庆祝；不得将胜利一笔带过
庆祝重点:
- 展现灾变消退的直接迹象：极寒退去、天空与魔力潮恢复、南下军势瓦解，幸存者终于确认危机结束
- 根据当前地区选择合适的庆祝形式，如鸣钟、点灯、宴饮、祭奠死者、军民相拥、传递捷报或重开商路；允许不同势力以各自文化纪念胜利
- 庆祝应保留战争代价与对逝者的敬意，使喜悦、疲惫、哀悼与对重建的期待共同存在
- 若<user>参与击败异神，应让其获得相称的感谢、荣誉或与相关人物的互动；若未直接参与，也应能从所在地感受到这场大陆级胜利
</event>
<%_ } else { _%>
<%_ if (phase2Recent) { _%>
<event>
触发: 冰之歌事件进入二阶段
要求: 必须将此事视为已经真正降临的大陆级灾变，而非单纯前兆或普通地区动乱；要显著提高其在叙事中的权重，在当前场景、传闻、局势、敌对动向、居民情绪、补给压力与环境变化中明确体现其后果，不能淡化、回避或缩小其影响范围
影响重点:
- 异神已经自北境降临并开始南下，战争与灾变已经正式开始向大陆腹地推进
- 必须出现全大陆可感知的异象：例如反常极夜、极昼失衡、漫天霜辉、极光横跨诸国、群星失序、天空裂霜、四季紊乱或大范围魔力潮异常；即使远离北境的地区，也能直接观测或听闻其异变
- 异神降临应伴随规则层面的压迫与扩散，例如极寒蔓延、魔物异变、信仰震荡、古老封印失衡、局部法则扭曲，令环境、生态与超凡体系本身都出现不稳定征兆
- 北境、帝国、联盟、法环、精灵王庭、梵尼亚等各大势力都应立即作出反应，体现大陆整体秩序被撼动
- 若当前剧情涉及风险评估、路线选择、停留休整或冲突遭遇，应优先纳入该事件影响，并默认世界已进入更危险、更紧张、更失序的战时状态
- 当前<user>实力或许不足以成为英雄，但是<user>可以见证整个大陆的顶尖力量如何面对灾难
</event>
<%_ } _%>
<%_ if (time2 != null && !hasDefeated) { _%>
<event>
触发: 冰之歌事件二阶段持续中
要求: 异神仍在北境南下，战争与灾变尚未结束；持续将其后果纳入叙事，不得擅自宣告胜利或淡化为普通地区冲突
<!-- SYSTEM_COMMAND_START -->
异神被击败后处理：必须在<UpdateVariable>的JSON Patch中包含: { "op": "replace", "path": "/事件/冰之歌/异神已击败", "value": true }
<!-- SYSTEM_COMMAND_END -->
</event>
<%_ } _%>
<%_ if (time2 == null && phase1Recent) { _%>
<event>
触发: 冰之歌事件进入扩散阶段
要求: 必须将此事视为大陆级灾变的明确前兆与扩散开端，在当前场景、传闻、局势、敌对动向、居民情绪、补给压力与环境变化中明确体现其后果，不能将其视为无关背景或局部边境摩擦
影响重点:
- 北境长垣防线崩溃意味着大陆抵御北方灾厄的第一道屏障已经失效，这应被视为后续更大灾变即将到来的强烈信号
- 北境与相关边境地区应迅速出现军情紧张、居民撤离、要塞戒严、斥候失联、商路受阻、谣言蔓延或物资囤积等连锁反应
- 气候、魔物活动、局部异象、古老预言、宗教反应或高层势力判断中，应开始出现“不祥征兆正在累积”的一致趋势
- 若当前剧情涉及局势判断、任务抉择或角色反应，应优先考虑这场灾变前兆带来的现实后果，并允许角色意识到更大危机正在逼近
</event>
<%_ } _%>
<%_ } _%>

<%_ } // end block _%>
